<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_dialogs_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialogs_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_alert"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_confirm"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_custom"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_bottom_sheet"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_dialog_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_dialog_result"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="@color/gray_light" />

</LinearLayout>
