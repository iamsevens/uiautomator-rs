<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_concurrent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/concurrent_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_counter1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_counter1"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="@color/blue"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_counter2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_counter2"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="@color/green"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_counter3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_counter3"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="@color/orange"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_increment_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_increment_all"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_reset_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_reset_all" />

</LinearLayout>
